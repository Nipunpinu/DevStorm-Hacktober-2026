# YojanaSetu Backend Environment Configuration

# Database: SQLite for local dev, PostgreSQL compatible
DATABASE_URL=sqlite:///./yojanasetu.db
# Example for PostgreSQL: postgresql://user:password@localhost:5432/yojanasetu

# Hugging Face Inference Providers Configuration (Official SDK)
# Documentation: https://huggingface.co/docs/inference-providers/index
# Generate token at: https://huggingface.co/settings/tokens (Read or Inference permissions)
HF_TOKEN=hf_your_token_here
# Popular supported models: meta-llama/Llama-3.3-70B-Instruct, deepseek-ai/DeepSeek-V3-0324, Qwen/Qwen2.5-72B-Instruct
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Optional provider routing (e.g., together, sambanova, novita, groq; leave empty for auto-routing)
HF_PROVIDER=

# Optional OpenAI SDK Configuration (fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# CORS Origin for Frontend
FRONTEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:5500

# Security & JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
